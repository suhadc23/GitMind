generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  clerkId            String              @unique
  imageUrl           String?
  firstName          String?
  lastName           String?
  emailAddress       String              @unique
  credits            Int                 @default(150)
  githubAccessToken  String?
  githubUsername     String?
  questions          Question[]
  stripeTransactions StripeTransaction[]
  userToProjects     UserToProject[]
  reviewComments     ReviewComment[]
  reviewerSlots      Reviewer[]
}

model Project {
  id                   String                @id @default(cuid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  name                 String
  githubUrl            String
  deletedAt            DateTime?
  commits              Commit[]
  meetings             Meeting[]
  questions            Question[]
  sourceCodeEmbeddings SourceCodeEmbedding[]
  userToProjects       UserToProject[]
  codeHealthReport     CodeHealthReport?
  securityScanReport   SecurityScanReport?
  pullRequests         PullRequest[]
  graphNodes           GraphNode[]
  graphEdges           GraphEdge[]
  graphBuildStatus     GraphBuildStatus?
}

model UserToProject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model SourceCodeEmbedding {
  id         String   @id @default(cuid())
  sourceCode String   @db.Text
  fileName   String
  summary    String   @db.Text
  fileSha    String?
  embedding  Json?
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Meeting {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  name       String
  meetingUrl String
  projectId  String
  status     MeetingStatus @default(PROCESSING)
  issues     Issue[]
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Issue {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  start     String
  end       String
  gist      String   @db.Text
  headline  String
  summary   String   @db.Text
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model StripeTransaction {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  credits         Int
  stripeSessionId String?  @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  question        String   @db.Text
  answer          String   @db.Text
  filesReferences Json?
  projectId       String
  userId          String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Commit {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  projectId          String
  commitMessage      String   @db.Text
  commitHash         String
  commitAuthorName   String
  commitAuthorAvatar String
  commitDate         DateTime
  summary            String   @db.Text
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum MeetingStatus {
  PROCESSING
  COMPLETED
}

model CodeHealthReport {
  id                 String             @id @default(cuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  projectId          String             @unique
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  overallScore       Int
  cleanlinessScore   Int
  organizationScore  Int
  errorHandlingScore Int
  duplicationScore   Int
  documentationScore Int
  todoCount          Int
  fixmeCount         Int
  consoleLogs        Int
  largeFileCount     Int
  totalFilesAnalyzed Int
  fileDetails        Json
  aiInsights         String             @db.Text
  status             HealthReportStatus @default(PROCESSING)
}

enum HealthReportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================
// FEATURE: Security Scan
// ============================================================

model SecurityScanReport {
  id                String             @id @default(cuid())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  projectId         String             @unique
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  overallScore      Int
  criticalCount     Int
  highCount         Int
  mediumCount       Int
  totalIssues       Int
  totalFilesScanned Int
  topFindings       Json
  aiInsights        String             @db.Text
  status            HealthReportStatus @default(PROCESSING)
}

// ============================================================
// FEATURE: Real-Time Collaborative Code Review with AI
// ============================================================

model PullRequest {
  id                String       @id @default(cuid())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  projectId         String
  githubPrNumber    Int
  title             String
  description       String?      @db.Text
  authorGithubLogin String
  authorAvatarUrl   String?
  baseBranch        String
  headBranch        String
  githubUrl         String
  aiSummary         String?      @db.Text
  status            ReviewStatus @default(PENDING)

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewers Reviewer[]
  comments  ReviewComment[]
  files     PRFile[]

  @@unique([projectId, githubPrNumber])
  @@index([projectId])
}

model PRFile {
  id            String          @id @default(cuid())
  pullRequestId String
  fileName      String
  status        String
  additions     Int             @default(0)
  deletions     Int             @default(0)
  patch         String?         @db.Text

  pullRequest PullRequest     @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  comments    ReviewComment[]

  @@index([pullRequestId])
}

model ReviewComment {
  id            String             @id @default(cuid())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  pullRequestId String
  prFileId      String?
  lineNumber    Int?
  side          String?
  body          String             @db.Text
  commentType   CommentType        @default(HUMAN)
  aiCategory    AICommentCategory?
  severity      Int?
  userId        String?
  resolved      Boolean            @default(false)

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  prFile      PRFile?     @relation(fields: [prFileId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pullRequestId])
  @@index([prFileId])
}

model Reviewer {
  id            String       @id @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  pullRequestId String
  userId        String
  status        ReviewStatus @default(PENDING)

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, userId])
  @@index([pullRequestId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum CommentType {
  HUMAN
  AI
}

enum AICommentCategory {
  SECURITY
  PERFORMANCE
  STYLE
  BUG
  GENERAL
}

// ============================================================
// FEATURE: Interactive Codebase Knowledge Graph
// ============================================================

model GraphNode {
  id           String        @id @default(cuid())
  projectId    String
  name         String
  type         GraphNodeType
  filePath     String
  startLine    Int?
  endLine      Int?
  language     String
  layer        String?
  aiSummary    String?       @db.Text
  lastAuthor   String?
  lastModified DateTime?
  metadata     Json?

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outEdges GraphEdge[] @relation("sourceNode")
  inEdges  GraphEdge[] @relation("targetNode")

  @@index([projectId])
  @@index([projectId, type])
  @@index([projectId, filePath])
}

model GraphEdge {
  id           String        @id @default(cuid())
  projectId    String
  sourceNodeId String
  targetNodeId String
  type         GraphEdgeType

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceNode GraphNode @relation("sourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode GraphNode @relation("targetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId, type])
  @@index([projectId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model GraphBuildStatus {
  id         String    @id @default(cuid())
  projectId  String    @unique
  status     String    @default("IDLE")
  progress   Int       @default(0)
  nodesCount Int       @default(0)
  edgesCount Int       @default(0)
  error      String?   @db.Text
  builtAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum GraphNodeType {
  FILE
  FUNCTION
  CLASS
  API_ROUTE
  DB_QUERY
}

enum GraphEdgeType {
  IMPORTS
  CALLS
  EXTENDS
  IMPLEMENTS
  USES_ROUTE
  QUERIES
}
